# Configuration for r730-fan-control, sourced by /usr/local/bin/r730-fan-control.sh.
# Uncomment a line to override the built-in default. Changes take effect on the
# next timer run (within 5 minutes). This file survives re-running install.sh.

# Day window, 24h clock: day = DAY_START:00 through (DAY_END-1):59
#DAY_START=8
#DAY_END=20

# Months treated as winter (space-separated, 1-12)
#WINTER_MONTHS="12 1 2"

# Fan speeds as hex percent
#WINTER_DAY=0x19    # 25%
#WINTER_NIGHT=0x14  # 20%
#SUMMER_DAY=0x1e    # 30%
#SUMMER_NIGHT=0x19  # 25%

# Failsafe thresholds, degrees C.
# At/above either MAX: revert to iDRAC automatic control.
# At/below both RESUME: safe to (re)apply manual control.
#EXHAUST_MAX=45
#CPU_MAX=75
#EXHAUST_RESUME=40
#CPU_RESUME=68

# Path to ipmitool
#IPMITOOL=/usr/bin/ipmitool
